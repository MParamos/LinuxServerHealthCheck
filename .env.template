# LinuxServerHealthCheck Configuration File Template
# Rename this file to .env and configure your variables before running docker-compose.

# System Settings
MACHINE_NAME=MyServer
LANGUAGE=en # Supported options: es, en, fr
DESTINATION_EMAIL=admin@yourdomain.com

# SMTP Configuration
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=alert@yourdomain.com
SMTP_PASS=YourSuperSecretPassword

# Execution Schedule
# You can use standard cron syntax for precise control (Minute Hour Day Month DayOfWeek)
# Example: "0 4 * * 1" runs at 04:00 AM every Monday. 
# You can also use macros like @daily, @weekly, @monthly.
CRON_SCHEDULE="0 4 * * 1"

# Authorized Ports (space separated)
# WARNING: By listing ports here, you acknowledge that you understand their purpose 
# and accept the security risks. They will bypass the red alert warnings in the report. 
# If a malicious backdoor uses one of these ports, it is solely your responsibility.
ALLOWED_PORTS="22 80 443"
